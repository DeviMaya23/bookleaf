meta {
  name: Get Image
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/images/:id
  body: none
  auth: inherit
}

params:path {
  id: {{imageId}}
}

docs {
  Response includes `folder_ids: string[]` — an array of all folder UUIDs this image belongs to (empty array when unfiled).
  The singular `folder_id` and `position` fields have been removed.
}
