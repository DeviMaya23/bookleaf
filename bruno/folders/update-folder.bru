meta {
  name: Update Folder
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/folders/{{folderId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "renamed folder",
    "icon": "star"
  }
}

docs {
  Set `icon` to `null` to reset the folder to the default icon:

  ```json
  { "icon": null }
  ```
}
