# AMO API credentials for signing the Firefox build for self-distribution.
# Generate at https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# Cloudflare R2 credentials for uploading release artifacts.
# Token requires "Workers R2 Storage:Edit" permission scoped to the extension
# distribution bucket. This bucket is separate from the app's R2 bucket.
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=
