{
  "manifest_version": 3,
  "name": "Bookleaf",
  "version": "1.0.5",
  "description": "Save images to Bookleaf from any webpage.",
  "permissions": ["storage", "identity", "contextMenus", "activeTab"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "commands": {
    "snip-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Snip to Bookleaf"
    },
    "browse-images": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Browse images on this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Bookleaf"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}
