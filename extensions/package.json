{
  "name": "bookleaf-extension",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome:prod": "vite build --mode chrome-production",
    "build:firefox": "vite build --mode firefox",
    "build:firefox:prod": "vite build --mode firefox-production",
    "build:all": "vite build && vite build --mode firefox",
    "sign:firefox": "bash scripts/sign-firefox.sh",
    "release:firefox": "bash scripts/release-firefox.sh",
    "release:chrome": "bash scripts/release-chrome.sh",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.6",
    "web-ext": "^9.0.1",
    "webextension-polyfill": "^0.12.0",
    "wrangler": "^4.106.0"
  }
}
